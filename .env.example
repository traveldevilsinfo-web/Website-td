# Copy to .env.local and fill in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. Local: createdb traveldevils. Then: npm run db:migrate
DATABASE_URL=postgres://localhost:5432/traveldevils

# Uploads. Without Supabase they go to this folder on disk (fine for local dev).
UPLOAD_DIR=./uploads

# Supabase (production). Project Settings → API: URL + service_role key (server-only, never NEXT_PUBLIC_).
# With these set, uploads go to Supabase Storage (public bucket "media") and /uploads/* is served from it.
# On Vercel, DATABASE_URL = Supabase "Transaction pooler" string (port 6543).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=media

# One-time copy of this local site to Supabase: put these in .env.supabase, then `npm run supabase:push`.
#   SUPABASE_DB_URL=<"Session pooler" or direct connection string, port 5432>
#   SUPABASE_URL=...  SUPABASE_SERVICE_ROLE_KEY=...

# PDF itinerary import (Admin → Trips → Import from PDF). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Payments: Razorpay (dashboard.razorpay.com → Settings → API Keys). Without these, development runs in TEST MODE
# (simulated payments); production refuses to take bookings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<your-domain>/api/payments/webhook, events payment.captured + payment.failed
RAZORPAY_WEBHOOK_SECRET=

# OTP SMS: MSG91 (DLT-approved template with an ##OTP## variable). Without these, dev prints the OTP to the server console.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Random long string used to hash OTPs (openssl rand -hex 32)
OTP_SECRET=
